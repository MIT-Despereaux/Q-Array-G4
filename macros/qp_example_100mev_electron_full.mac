# One fully recorded 100 meV electron event at the chip center.
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/g4cmp/recordMinETracks false
/g4cmp/phononBounces 10
/g4cmp/qpBounces 100
/g4cmp/minEPhonons 0.00035 eV
# The 100 meV event is below this threshold, so secondary production is not downsampled.
/g4cmp/samplingEnergy 1 eV
/smoke/maxQPSteps 0
/smoke/recordAllQPSteps true
/smoke/requireQPs true
/smoke/expectedMaterial G4_Si
/run/initialize
/random/setSeeds 100854 4824
/gps/number 1
/gps/particle e-
/gps/pos/type Point
/gps/pos/centre 0 0 5.0 mm
/gps/direction 0 0 1
/gps/ene/type Mono
/gps/ene/mono 100 meV
/run/beamOn 1
