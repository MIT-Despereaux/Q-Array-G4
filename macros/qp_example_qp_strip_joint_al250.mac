# Single near-gap QPs started uniformly in a 30 x 5 um window straddling the shl5/halfCircle4 joint of resonator 2's center strip (x = 1.9996 mm).
# A transparent, unbiased joint keeps both halves at equal density. Steps are
# capped because QPs in the 10 um strip take very short diffusion steps.
/control/verbose 0
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/g4cmp/recordMinETracks false
/g4cmp/phononBounces 10000
/g4cmp/qpBounces 1000000
/g4cmp/minEPhonons 0.00035 eV
/g4cmp/samplingEnergy 100 eV
/smoke/maxQPSteps 20000
/smoke/recordAllQPSteps false
/smoke/qpSampleIntervalNs 100
/smoke/requireQPs true
/smoke/expectedMaterial G4_Al
/smoke/expectedGroundPlaneMaterial G4_Al
/smoke/expectedGroundPlaneThicknessNm 250
/smoke/mergeConnectedAl true
/run/initialize
/random/setSeeds {seed1} {seed2}
/gps/number 1
/gps/particle BogoliubovQP
/gps/pos/type Plane
/gps/pos/shape Rectangle
/gps/pos/centre 1.9996 1.0256 5.000225 mm
/gps/pos/halfx 0.015 mm
/gps/pos/halfy 0.0025 mm
/gps/direction -1 0 0
/gps/ene/type Mono
/gps/ene/mono 0.00019 eV
/run/beamOn 1000
